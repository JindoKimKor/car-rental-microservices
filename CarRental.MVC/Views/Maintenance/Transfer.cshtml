@using System.Text.Json

@{
    ViewData["Title"] = "Budget Transfer";
}

<h2>Budget Transfer</h2>

<form method="get" asp-action="Transfer">
    <div class="form-group">
        <label>From Repair ID</label>
        <input type="number" name="fromId" class="form-control" required />
    </div>
    <div class="form-group mt-2">
        <label>To Repair ID</label>
        <input type="number" name="toId" class="form-control" required />
    </div>
    <div class="form-group mt-2">
        <label>Amount</label>
        <input type="number" name="amount" step="0.01" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Transfer</button>
</form>

<hr />

@if (ViewBag.Result != null)
{
    var json = JsonDocument.Parse((string)ViewBag.Result).RootElement;

    if (json.TryGetProperty("error", out var error))
    {
        <div class="alert alert-danger mt-3">
            <strong>@error.GetString()</strong>: @json.GetProperty("message").GetString()
        </div>
    }
    else
    {
        <div class="alert alert-success mt-3">
            <strong>@json.GetProperty("message").GetString()</strong>
        </div>
    }
}
